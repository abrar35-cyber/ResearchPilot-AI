# This file is only a CHECKLIST of variable names. It is never read by the app.
# Do NOT put real values here and do NOT commit real keys to GitHub.
#
# Add the real values in Netlify:
#   Site configuration → Environment variables → Add a variable
#   - Tick "Contains secret values" for GROQ_API_KEY and ADMIN_TOKEN.
#   - Keep the default scopes (All scopes) so server code can read them at runtime.
#   - After adding or changing variables, trigger a new deploy.
#
# Never prefix secrets with NEXT_PUBLIC_ (that would expose them in the browser).

# --- AI ---
GROQ_API_KEY=
# Check console.groq.com for the free-tier models currently available
GROQ_MODEL=llama-3.3-70b-versatile
# Max time for ONE Groq request, in milliseconds (2000-28000)
AI_CALL_TIMEOUT_MS=20000

# --- Hard budget limits per research run (all optional; these are the defaults) ---
BUDGET_MAX_AI_CALLS=24
BUDGET_MAX_TOKENS=60000
BUDGET_MAX_SECONDS=240
BUDGET_MAX_RETRIES=2
# Share of calls/tokens kept back for writing the final report (0-50)
BUDGET_REPORT_RESERVE_PERCENT=25

# --- Testing ---
# Any long random string. Needed only to run /api/health?check=ai
ADMIN_TOKEN=

# --- Scholarly APIs (used from Phase 3) ---
# Optional contact email: puts requests in the "polite" pool of OpenAlex/Crossref
CONTACT_EMAIL=

# --- Only if /api/health?check=storage reports that Blobs is not configured ---
BLOBS_SITE_ID=
BLOBS_TOKEN=
